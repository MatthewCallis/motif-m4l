{
  "name": "motif-m4l",
  "version": "0.3.4",
  "private": true,
  "description": "A scale-aware, triggerable motif engine for Max for Live.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-builtins.mjs && node scripts/generate-max-patch.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run generate && tsc --noEmit",
    "test": "npm run generate && npm run build && tsx --test tests/**/*.test.ts",
    "verify": "npm run check && npm test",
    "midi:import": "tsx scripts/midi-to-motif.ts",
    "midi:export": "tsx scripts/motif-to-midi.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.1",
    "midi-file": "^1.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
