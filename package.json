{
  "name": "motif-m4l",
  "version": "0.3.8",
  "private": true,
  "description": "A scale-aware, triggerable motif engine for Max for Live.",
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/build.ts",
    "build": "tsx scripts/build.ts",
    "clean": "tsx scripts/clean.ts",
    "build:clean": "npm run clean && npm run build",
    "check": "npm run build:clean && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run build:clean && c8 tsx --test tests/**/*.test.ts",
    "verify": "npm run lint && npm run check && npm test && npm run validate:max",
    "midi:import": "tsx scripts/midi-to-motif.ts",
    "midi:export": "tsx scripts/motif-to-midi.ts",
    "validate:max": "tsx scripts/validate-max-device.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "midi-file": "^1.2.4",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
